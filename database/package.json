{
  "name": "@bounty/database",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:push": "bun --env-file=.env.local drizzle-kit push",
    "db:studio": "bun --env-file=.env.local drizzle-kit studio",
    "db:seed": "bun --env-file=.env.local run src/seed.ts",
    "db:reset": "bun --env-file=.env.local run src/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
