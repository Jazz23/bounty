{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Replay Delivery",
            "program": "${workspaceFolder}/github-app/test/redeliver-latest.ts",
            "args": ["--event", "${input:eventAction}"],
            "cwd": "${workspaceFolder}/github-app",
            "stopOnEntry": false,
            "watchMode": false
        }
    ],
    "inputs": [
        {
            "id": "eventAction",
            "type": "promptString",
            "description": "Event to redeliver (e.g. issues.opened)"
        }
    ]
}